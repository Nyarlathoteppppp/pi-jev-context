{
	"name": "pi-jev-context",
	"version": "0.5.0",
	"private": false,
	"description": "Position-aware read deduplication and optional active Jev fresh-log sieve for Pi, with original-output recall.",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc --noEmit",
		"bench": "node bench/seen-replay.ts",
		"test:archive": "node --test bench/archive/extension.test.ts"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@types/node": "^24.0.0",
		"typebox": "^1.3.7",
		"typescript": "^5.9.0"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"jev",
		"typesafe",
		"context"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Nyarlathoteppppp/pi-jev-context.git"
	},
	"author": "Nyarlathoteppppp"
}

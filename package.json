{
	"name": "pi-jev-context",
	"version": "0.2.1",
	"private": false,
	"description": "Cache-neutral context trimming for the pi coding agent, powered by TypeSafe Jev: shortens long bash logs to their key lines before they enter context, with lossless recall. Old-context pruning runs in shadow mode only.",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc --noEmit",
		"bench": "node bench/run.ts",
		"bench:dry": "node bench/run.ts --dry-run",
		"report": "node bench/report.ts"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@types/node": "^24.0.0",
		"typebox": "^1.3.7",
		"typescript": "^5.9.0"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"jev",
		"typesafe",
		"context"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Nyarlathoteppppp/pi-jev-context.git"
	},
	"author": "Nyarlathoteppppp"
}
